{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	@api path /api/* /uploads /uploads/* /healthz

	handle @api {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	log {
		output stdout
		format console
	}
}
